# Training Tracker GUI - Local Development Environment Configuration
# Copy this file to .env and update with your local settings

# ==============================================================================
# API Configuration
# ==============================================================================
# The base URL for the backend API
VITE_API_BASE_URL=http://localhost:5001/api

# ==============================================================================
# Google OAuth2 Configuration
# ==============================================================================
# Get this from Google Cloud Console: https://console.cloud.google.com/
# Use the same Client ID as the backend
VITE_OAUTH_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
